# Django Configuration
DEBUG=False
SECRET_KEY=your-secure-secret-key-change-in-production
JWT_SIGNING_KEY=your-secure-jwt-signing-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=campusxplore_db_v2
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IoT Device Token — shared secret for e-rickshaw GPS tracker pings
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
IOT_DEVICE_TOKEN=your-strong-random-iot-device-token-here

# JWT Token Lifetimes (optional, defaults shown)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Production SSL (set to True when behind HTTPS proxy)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
